NODE_ENV=development
PORT=10000

# Neon PostgreSQL connection strings
# DATABASE_URL: Pooled connection string (used at runtime)
DATABASE_URL=
# DIRECT_URL: Direct unpooled connection string (used for migrations and admin)
DIRECT_URL=

# JWT Secrets (Generate with `openssl rand -base64 32`)
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# CORS Allowed Origins (Comma-separated or * for mobile/dev)
CORS_ALLOWED_ORIGINS=*

# Public API URL
APP_BASE_URL=http://localhost:10000

# Firebase Cloud Messaging Credentials
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Email / SMTP Settings (Optional in dev, console logging fallback)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=FinishX <no-reply@finishx.app>

# Logging
LOG_LEVEL=info
